# ---- Local development ----
# Vite proxies /api to http://localhost:5000 in dev (see vite.config.js),
# so an absolute URL is only needed for production/hosted builds.
VITE_API_URL=http://localhost:5000/api
VITE_DUTCHIE_EMBED_URL=https://dutchie.com/embedded-menu/ct-clone-canabiss-meriden-med-rec

# ---- Render / production notes ----
# VITE_* values are inlined into the JS bundle at BUILD time.
# On Render set VITE_API_URL to the API's public URL, e.g.
#   https://demotest-api.onrender.com/api
# Changing it later requires a new build/redeploy.
