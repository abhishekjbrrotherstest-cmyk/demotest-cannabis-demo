# ---- Local development ----
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=demotest_cannabis
DB_USER=root
DB_PASSWORD=
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
DUTCHIE_EMBED_URL=https://dutchie.com/embedded-menu/ct-clone-canabiss-meriden-med-rec

# ---- Render / production notes ----
# PORT            : Render sets this automatically. Do not add it.
# NODE_ENV        : must be "production" (makes the auth cookie Secure).
# DB_HOST/PORT/NAME/USER/PASSWORD : from your hosted MySQL provider
#                                   (Render has no MySQL — use Aiven / TiDB / Railway).
# DB_SSL          : "true" for most hosted MySQL providers.
# DB_SSL_CA       : their CA certificate, newlines written as \n (optional).
# JWT_SECRET      : long random string (Render can generate one).
# CLIENT_URL      : exact origin of the frontend, e.g. https://demotest-web.onrender.com
#                   (used for CORS and the CSP connect-src allowlist).
# COOKIE_SAMESITE : keep "lax" while both apps stay on *.onrender.com;
#                   use "none" if the frontend moves to another domain.
DB_SSL=false
COOKIE_SAMESITE=lax
